# Public deployment URL used for Mercado Pago return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: URL and publishable key are safe in browser code; the secret never is.
NEXT_PUBLIC_SUPABASE_URL=https://urmbjxmijtwovkzmvoav.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Kept for the server-side checkout/payment adapter only.
SUPABASE_URL=https://urmbjxmijtwovkzmvoav.supabase.co
SUPABASE_SECRET_KEY=

# Mercado Pago Checkout Pro / Orders API
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Transactional order emails (Resend). Keep the API key server-only.
RESEND_API_KEY=
ORDER_EMAIL_FROM=La Mediterránea <tienda@your-domain.com>
# Merchant/owner inbox that receives every confirmed paid order.
ORDER_NOTIFICATION_EMAIL=
