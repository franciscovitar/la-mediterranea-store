# Public deployment URL used for Mercado Pago return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: URL and publishable key are safe in browser code; the secret never is.
NEXT_PUBLIC_SUPABASE_URL=https://urmbjxmijtwovkzmvoav.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Kept for the server-side checkout/payment adapter only.
SUPABASE_URL=https://urmbjxmijtwovkzmvoav.supabase.co
SUPABASE_SECRET_KEY=

# Mercado Pago Checkout Pro / Orders API
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# CAUCE M2, independent fictional merchant DB. Leave disabled until its schema,
# seed, RLS, allowed Auth redirects and staff membership pass real integration QA.
# NEVER copy the historical SUPABASE_URL above into this configuration.
CAUCE_CATALOG_SOURCE=fixture
CAUCE_MERCHANT_ENABLED=false
NEXT_PUBLIC_CAUCE_SUPABASE_URL=
NEXT_PUBLIC_CAUCE_SUPABASE_PUBLISHABLE_KEY=
